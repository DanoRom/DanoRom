# Leave DATABASE_URL unset to use free local SQLite for development.
# For PostgreSQL (docker-compose up db):
# DATABASE_URL=postgresql+pg8000://devplatform:devplatform@localhost:5432/devplatform

# Google Gemini API key (free tier: https://aistudio.google.com/apikey).
# Leave empty to use the built-in zero-cost heuristic evaluator.
GEMINI_API_KEY=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
