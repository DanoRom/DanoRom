{
  "_about": [
    "Ordered rules. FIRST MATCH WINS. Anything unmatched falls through to default_tier.",
    "",
    "Tiers:",
    "  SKIP    never uploaded, never deleted. System files, and anything already",
    "          synced to a cloud (deleting those locally would delete them upstream).",
    "  JUNK    deleted without uploading. Reproducible, re-downloadable, or worthless.",
    "  ARCHIVE uploaded, verified, then the local copy is reclaimed. The cold tier.",
    "  SYNC    uploaded and kept locally. Hot data you still touch.",
    "",
    "  prune:  true means the scanner records the whole directory as ONE entry and",
    "          does not walk it file-by-file. This is what makes a 1.5TB scan finish",
    "          in minutes instead of hours, and it keeps 400k node_modules files out",
    "          of the catalog entirely.",
    "",
    "Glob notes: paths are lowercased with forward slashes. '*' matches '/' too, so",
    "'*/cache/*' is recursive, and it also matches the directory itself.",
    "Windows paths look like 'c:/users/dano/...'."
  ],

  "default_tier": "ARCHIVE",

  "rules": [

    { "name": "cloud-services-evacuate",
      "tier": "ARCHIVE",
      "_why": "You want OneDrive/iCloud/Dropbox gone. ARCHIVE, not JUNK: the",
      "_why2": "contents get copied into Black Mamba and MD5-verified first, then",
      "_why3": "the local folder is reclaimed. Same end state, nothing lost.",
      "_danger": "Read docs/CLOUD-EVICTION.md before running this. Two traps:",
      "_danger2": "(1) these folders sync, so a local delete propagates upstream;",
      "_danger3": "(2) online-only placeholder files are 0 bytes on disk and will",
      "_danger4": "archive as empty unless you force a full download first.",
      "glob": ["*/onedrive*/*", "*/dropbox/*",
               "*/icloud drive/*", "*/icloudphotos/*", "*/icloud photos/*",
               "*/mega/*", "*/pcloudrive/*", "*/box sync/*"] },

    { "name": "cloud-client-caches",
      "tier": "JUNK", "prune": true,
      "_why": "Sync-client scratch space. Pure junk, no upload needed.",
      "glob": ["*/.dropbox.cache/*", "*/.dropbox.dist/*",
               "*/onedrivetemp/*", "*/appdata/local/microsoft/onedrive/setup/*",
               "*/appdata/roaming/apple computer/mobilesync/*",
               "*/appdata/local/apple/*/cache/*"] },

    { "name": "destination-folder",
      "tier": "SKIP",
      "_why": "Never re-upload the staging/mirror of Black Mamba itself.",
      "glob": ["*/google drive/*", "*/googledrive/*", "*/my drive/*",
               "*/black mamba - home-server-cloud/*"] },

    { "name": "windows-pagefiles",
      "tier": "SKIP",
      "_why": "Locked by the kernel. Not yours to move.",
      "glob": ["*/pagefile.sys", "*/hiberfil.sys", "*/swapfile.sys",
               "*/dumpstack.log*", "*/system volume information/*",
               "*/$recycle.bin/*", "*/$windows.~*/*"] },

    { "name": "windows-temp",
      "tier": "JUNK", "prune": true,
      "glob": ["*/appdata/local/temp/*", "*/windows/temp/*", "c:/temp/*",
               "*/appdata/local/*/cache/*", "*/appdata/local/*/cache2/*",
               "*/appdata/local/packages/*/localcache/*",
               "*/appdata/local/crashdumps/*",
               "*/appdata/local/microsoft/windows/inetcache/*",
               "*/appdata/local/microsoft/windows/explorer/*",
               "*/appdata/local/d3dscache/*", "*/appdata/local/nvidia/*",
               "*/windows.old/*"] },

    { "name": "unix-temp",
      "tier": "JUNK", "prune": true,
      "glob": ["/tmp/*", "/var/tmp/*", "/var/cache/*", "/var/log/*",
               "*/.cache/*", "*/.local/share/trash/*", "*/.thumbnails/*",
               "*/.local/share/baloo/*"] },

    { "name": "browser-cache",
      "tier": "JUNK", "prune": true,
      "glob": ["*/cache_data/*", "*/code cache/*", "*/gpucache/*",
               "*/service worker/cachestorage/*", "*/shadercache/*",
               "*/mozilla/firefox/*/cache*/*", "*/chromium/*/cache/*",
               "*/google/chrome/*/cache/*", "*/brave*/*/cache/*"] },

    { "name": "system-tree",
      "tier": "SKIP", "prune": true,
      "glob": ["c:/windows/*", "c:/program files/*", "c:/program files (x86)/*",
               "c:/programdata/*", "c:/perflogs/*", "c:/recovery/*",
               "*/appdata/roaming/*", "*/appdata/local/microsoft/*",
               "/proc/*", "/sys/*", "/dev/*", "/run/*", "/boot/*", "/etc/*",
               "/usr/*", "/bin/*", "/sbin/*", "/lib/*", "/lib64/*", "/opt/*",
               "/var/lib/*", "/snap/*", "/system/*", "/library/*",
               "*/.git/objects/*"] },

    { "name": "game-libraries",
      "tier": "JUNK", "prune": true,
      "_why": "Re-downloadable from the storefront for free. Usually the single",
      "_why2": "biggest win on a gaming PC. Saves and configs live elsewhere and",
      "_why3": "are matched by game-saves below, which runs BEFORE this rule.",
      "glob": ["*/steamapps/common/*", "*/steamapps/downloading/*",
               "*/steamapps/shadercache/*", "*/steamapps/workshop/*",
               "*/epic games/*", "*/gog galaxy/games/*",
               "*/battle.net/*", "*/riot games/*", "*/origin games/*",
               "*/ea games/*", "*/ubisoft game launcher/*",
               "*/xboxgames/*", "*/windowsapps/*"] },

    { "name": "package-caches",
      "tier": "JUNK", "prune": true,
      "glob": ["*/node_modules/*", "*/.venv/*", "*/venv/*", "*/__pycache__/*",
               "*/.pytest_cache/*", "*/.mypy_cache/*", "*/.ruff_cache/*",
               "*/.tox/*", "*/.gradle/*", "*/.m2/repository/*",
               "*/.cargo/registry/*", "*/.rustup/toolchains/*",
               "*/.nuget/packages/*", "*/packages/microsoft.*/*",
               "*/.npm/_cacache/*", "*/.yarn/cache/*", "*/.pnpm-store/*",
               "*/pip/cache/*", "*/.docker/*", "*/vagrant.d/boxes/*",
               "*/.conda/pkgs/*", "*/anaconda3/pkgs/*"] },

    { "name": "build-output",
      "tier": "JUNK", "prune": true,
      "glob": ["*/target/debug/*", "*/target/release/*", "*/.next/*",
               "*/.nuxt/*", "*/.parcel-cache/*", "*/.turbo/*",
               "*/cmake-build-*/*", "*/x64/debug/*", "*/x64/release/*",
               "*/obj/debug/*", "*/obj/release/*", "*/bin/debug/*",
               "*/bin/release/*", "*/.vs/*", "*/.idea/caches/*"] },

    { "name": "junk-files",
      "tier": "JUNK",
      "glob": ["*/thumbs.db", "*/desktop.ini", "*/.ds_store", "*/~$*",
               "*.tmp", "*.temp", "*.crdownload", "*.part", "*.partial",
               "*.chk", "*.old", "*.bak~", "*/core.[0-9]*"] },

    { "name": "empty-files",
      "tier": "JUNK",
      "max_size": 0 },

    { "name": "stale-installers",
      "tier": "JUNK",
      "_why": "Setup binaries older than a year. The vendor has a newer one.",
      "ext": ["exe", "msi", "msix", "appx", "dmg", "pkg", "deb", "rpm", "appimage"],
      "older_than_days": 365,
      "min_size": 5242880 },

    { "name": "game-saves",
      "tier": "SYNC",
      "_why": "Small, irreplaceable. Uploaded AND kept.",
      "glob": ["*/steamapps/common/*/saves/*", "*/my games/*",
               "*/saved games/*", "*/*/savegames/*", "*/steamapps/sdk*/*"] },

    { "name": "hot-work",
      "tier": "SYNC",
      "_why": "Touched in the last 6 months and lives somewhere you actually work.",
      "glob": ["*/desktop/*", "*/documents/*", "*/dev/*", "*/code/*",
               "*/projects/*", "*/src/*", "*/repos/*", "*/workspace/*"],
      "newer_than_days": 180,
      "max_size": 2147483648 },

    { "name": "credentials-and-keys",
      "tier": "SYNC",
      "_why": "Never bulk-deleted. Review these by hand before anything leaves.",
      "glob": ["*/.ssh/*", "*/.gnupg/*", "*/.aws/*", "*/.kube/*",
               "*.pem", "*.key", "*.pfx", "*.p12", "*.kdbx", "*.keychain*"] },

    { "name": "vm-and-disk-images",
      "tier": "ARCHIVE",
      "_why": "Huge, and often sparse. Shut the VM down before archiving it.",
      "ext": ["vhd", "vhdx", "vmdk", "qcow2", "vdi", "img", "iso", "wim", "esd"] },

    { "name": "media-cold",
      "tier": "ARCHIVE",
      "ext": ["mp4", "mkv", "avi", "mov", "wmv", "flv", "m4v", "mpg", "mpeg",
              "ts", "m2ts", "webm", "raw", "cr2", "cr3", "nef", "arw", "dng",
              "orf", "rw2", "psd", "ai", "prproj", "veg", "flac", "wav", "aiff"] },

    { "name": "archives-cold",
      "tier": "ARCHIVE",
      "ext": ["zip", "7z", "rar", "tar", "gz", "bz2", "xz", "zst", "tgz", "cab"] }
  ]
}
